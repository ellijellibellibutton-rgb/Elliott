# Pooled connection string (used by the app at runtime).
# Direct/unpooled connection string (used for migrations).
# On Vercel, add the Postgres integration (Neon or Vercel Postgres) and it
# will populate equivalents of these automatically — map them to
# DATABASE_URL / DIRECT_URL in your Vercel project's env vars.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
